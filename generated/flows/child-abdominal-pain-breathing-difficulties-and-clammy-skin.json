onical_node_id":"a9e0eb1b-8478-5801-9944-d263e7cc20c8"}},{"id":"00ad5448-00a7-51ef-b488-430d1c85bc54","role":"instruction","text":"Flushing\nПокраснение лица","media":[],"next":"c501d951-8012-5086-a005-730ed5935c61","input":null,"source":{"original_shape_id":"4221","canonical_node_id":"00ad5448-00a7-51ef-b488-430d1c85bc54"}},{"id":"7f1a7a53-823c-52dc-893c-209639e9d453","role":"instruction","text":"Rash (hives)\nСыпь (крапивница)","media":[],"next":"c501d951-8012-5086-a005-730ed5935c61","input":null,"source":{"original_shape_id":"4222","canonical_node_id":"7f1a7a53-823c-52dc-893c-209639e9d453"}},{"id":"01799143-452e-5a31-95c7-ed52b5f5ce7a","role":"instruction","text":"Cold skin\nХолодная кожа","media":[],"next":"c501d951-8012-5086-a005-730ed5935c61","input":null,"source":{"original_shape_id":"4223","canonical_node_id":"01799143-452e-5a31-95c7-ed52b5f5ce7a"}},{"id":"5f177936-acec-572c-a72a-215ee2355e65","role":"instruction","text":"Clammy skin\nВлажная кожа","media":[],"next":"c501d951-8012-5086-a005-730ed5935c61","input":null,"source":{"original_shape_id":"4224","canonical_node_id":"5f177936-acec-572c-a72a-215ee2355e65"}},{"id":"09700609-e718-5598-ba8b-3d63ed85b300","role":"instruction","text":"Diarrhoea\nДиарея","media":[],"next":"c501d951-8012-5086-a005-730ed5935c61","input":null,"source":{"original_shape_id":"4225","canonical_node_id":"09700609-e718-5598-ba8b-3d63ed85b300"}},{"id":"4a20943f-a763-5bd4-a9b2-f0032c675144","role":"start","text":"Abdominal pain\nБоль в животе","media":[],"next":"c501d951-8012-5086-a005-730ed5935c61","input":null,"source":{"original_shape_id":"4227","canonical_node_id":"4a20943f-a763-5bd4-a9b2-f0032c675144"}},{"id":"d6769b1c-febf-558e-8a23-7e0a523983ec","role":"instruction","text":"Recent exposure to known food allergens\nНедавний контакт с известными пищевыми аллергенами","media":[],"next":"c501d951-8012-5086-a005-730ed5935c61","input":null,"source":{"original_shape_id":"4229","canonical_node_id":"d6769b1c-febf-558e-8a23-7e0a523983ec"}},{"id":"cb0625c4-cddf-5eff-92b4-63b9852c17f8","role":"instruction","text":"Insect stings\nУкусы насекомых","media":[],"next":"c501d951-8012-5086-a005-730ed5935c61","input":null,"source":{"original_shape_id":"4231","canonical_node_id":"cb0625c4-cddf-5eff-92b4-63b9852c17f8"}},{"id":"9fa28134-87d2-5590-a179-db007470f97c","role":"emergency_instruction","text":"Call the emergency medical services. (Вызовите скорую помощь.)\nIf the dispatcher instructs you on your next steps, follow their instructions first. (Если диспетчер инструктирует Ваши дальнейшие шаги, отдавайте предпочтение инструкциям диспетчера.)\nEnsure that the child is lying down. If there are breathing difficulties, the child may sit up with their legs extended if tolerated. (Убедитесь, что ребёнок находится в положении лёжа. При затруднении дыхания ребёнку можно придать полусидячее положение с вытянутыми ногами, если он переносит его.)\nRemove the safety cap from the adrenaline auto-injector if known and possible. (Снимите защитный колпачок автоинжектора с адреналином, если это известно и возможно.)\nIntramuscular adrenaline should be given (by a trained individual or caregiver) as soon as possible via an age- and weight-appropriate auto-injector into the outer thigh, which delivers the recommended dose. (Адреналин следует вводить внутримышечно (обученным лицом или ухаживающим взрослым) как можно скорее с помощью автоинъектора, соответствующего возрасту и массе тела, во внешнюю поверхность бедра, что обеспечивает введение рекомендуемой дозы.)\nIf symptoms persist five minutes after administration, give a second dose of adrenaline, ideally in the opposite leg. (Если симптомы сохраняются в течение пяти минут после введения препарата, следует ввести вторую дозу адреналина, желательно в другую ногу.)\nIf possible, stay with the child until the ambulance arrives. (Если возможно, оставайтесь с ребёнком до приезда скорой помощи.)\nIf for some reason an ambulance is not available, take the child to the nearest medical facility. (Если по какой-то причине скорая помощь недоступна, доставьте ребёнка в ближайшее медицинское учреждение.)","media":[{"asset_id":"img-0e53218644d3ede0","url":"/media/img-0e53218644d3ede0.png","content_type":"image/png","association":"source-layout-adjacent-instruction","source_image_shape_id":"10","rights_status":"uncertain","review_required":true},{"asset_id":"img-ddfcc91e24d2abba","url":"/media/img-ddfcc91e24d2abba.png","content_type":"image/png","association":"source-layout-adjacent-instruction","source_image_shape_id":"11","rights_status":"uncertain","review_required":true}],"next":null,"input":null,"source":{"original_shape_id":"4232","canonical_node_id":"9fa28134-87d2-5590-a179-db007470f97c"}},{"id":"c501d951-8012-5086-a005-730ed5935c61","role":"choice","text":"Choose one or more of the following options: (Выберите один или несколько из нижеследующих вариантов:)","media":[{"asset_id":"img-b26158b441cc07ed","url":"/media/img-b26158b441cc07ed.png","content_type":"image/png","association":"source-layout-adjacent-instruction","source_image_shape_id":"1","rights_status":"uncertain","review_required":true}],"next":null,"input":{"kind":"choice","selection_mode":"multiple","presentation":"option_list","prompt":"Choose one or more of the following options: (Выберите один или несколько из нижеследующих вариантов:)","options":[{"id":"4234-option-1","label":"Abdominal pain (Боль в животе)","canonical_value":null,"exclusive":false,"result_codes":["C"],"go_to":"25c49aa3-4cdf-5aa6-b231-0aa381e8c7e1","source":{"label_shape_id":"4244","result_code_shape_ids":["4253"],"label_source":"group-row"},"review_required":true},{"id":"4234-option-2","label":"Breathing difficulties (Затрудненное дыхание)","canonical_value":null,"exclusive":false,"result_codes":["A"],"go_to":"9fa28134-87d2-5590-a179-db007470f97c","source":{"label_shape_id":"4245","result_code_shape_ids":["4262"],"label_source":"group-row"},"review_required":true},{"id":"4234-option-3","label":"Clammy skin (