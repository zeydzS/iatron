canonical_node_id":"1e1ed704-bf94-5983-816f-cf9a33f89a58"}},{"id":"bab9e053-153d-592d-a1ae-f1e1ca0247ba","role":"instruction","text":"Flushing\nПокраснение лица","media":[],"next":"c9315fb1-89bd-53d1-8fa1-036251502803","input":null,"source":{"original_shape_id":"4221","canonical_node_id":"bab9e053-153d-592d-a1ae-f1e1ca0247ba"}},{"id":"af5bcf00-b000-5daa-8cd8-5536ee7f7a9f","role":"instruction","text":"Rash (hives)\nСыпь (крапивница)","media":[],"next":"c9315fb1-89bd-53d1-8fa1-036251502803","input":null,"source":{"original_shape_id":"4222","canonical_node_id":"af5bcf00-b000-5daa-8cd8-5536ee7f7a9f"}},{"id":"cd33c4c8-3e95-5428-8485-b07226aa83ea","role":"instruction","text":"Cold skin\nХолодная кожа","media":[],"next":"c9315fb1-89bd-53d1-8fa1-036251502803","input":null,"source":{"original_shape_id":"4223","canonical_node_id":"cd33c4c8-3e95-5428-8485-b07226aa83ea"}},{"id":"974a9e5f-e474-5b91-bc06-062aff526a44","role":"instruction","text":"Clammy skin\nВлажная кожа","media":[],"next":"c9315fb1-89bd-53d1-8fa1-036251502803","input":null,"source":{"original_shape_id":"4224","canonical_node_id":"974a9e5f-e474-5b91-bc06-062aff526a44"}},{"id":"ba4622af-3cba-53f7-a87e-d4cdfd4af2b5","role":"instruction","text":"Diarrhoea\nДиарея","media":[],"next":"c9315fb1-89bd-53d1-8fa1-036251502803","input":null,"source":{"original_shape_id":"4225","canonical_node_id":"ba4622af-3cba-53f7-a87e-d4cdfd4af2b5"}},{"id":"2344db68-3a52-570f-9d2a-9aa87c96f3a9","role":"start","text":"Abdominal pain\nБоль в животе","media":[],"next":"c9315fb1-89bd-53d1-8fa1-036251502803","input":null,"source":{"original_shape_id":"4227","canonical_node_id":"2344db68-3a52-570f-9d2a-9aa87c96f3a9"}},{"id":"b4e80025-7c0a-5165-9e29-f07f9fce7169","role":"instruction","text":"Recent exposure to known food allergens\nНедавний контакт с известными пищевыми аллергенами","media":[],"next":"c9315fb1-89bd-53d1-8fa1-036251502803","input":null,"source":{"original_shape_id":"4229","canonical_node_id":"b4e80025-7c0a-5165-9e29-f07f9fce7169"}},{"id":"dc81d99f-1ecc-597f-bafb-833d73b7d2e4","role":"instruction","text":"Insect stings\nУкусы насекомых","media":[],"next":"c9315fb1-89bd-53d1-8fa1-036251502803","input":null,"source":{"original_shape_id":"4231","canonical_node_id":"dc81d99f-1ecc-597f-bafb-833d73b7d2e4"}},{"id":"72678c6f-3d3f-5bb2-a600-ef5fb5f0449d","role":"emergency_instruction","text":"Call the emergency medical services. (Вызовите скорую помощь.)\nIf the dispatcher instructs you on your next steps, follow their instructions first. (Если диспетчер инструктирует Ваши дальнейшие шаги, отдавайте предпочтение инструкциям диспетчера.)\nEnsure that the infant is lying flat on their back. If there are breathing difficulties, keep the head in a neutral position and avoid sitting or standing the infant. (Убедитесь, что младенец лежит на спине на ровной поверхности. При затруднении дыхания удерживайте голову в нейтральном положении; не усаживайте и не поднимайте ребёнка.)\nRemove the safety cap from the adrenaline auto-injector if known and possible. (Снимите защитный колпачок автоинжектора с адреналином, если это известно и возможно.)\nIntramuscular adrenaline should be given (by a trained individual or caregiver) as soon as possible via an age- and weight-appropriate auto-injector into the outer thigh, which delivers the recommended dose. (Адреналин следует вводить внутримышечно (обученным лицом или ухаживающим взрослым) как можно скорее с помощью автоинъектора, соответствующего возрасту и массе тела, во внешнюю поверхность бедра, что обеспечивает введение рекомендуемой дозы.)\nIf symptoms persist five minutes after administration, give a second dose of adrenaline, ideally in the opposite thigh. (Если симптомы сохраняются в течение пяти минут после введения препарата, следует ввести вторую дозу адреналина, предпочтительно в другое бедро.)\nIf possible, stay with the infant until the ambulance arrives. (Если возможно, оставайтесь с младенцем до приезда скорой помощи.)\nIf for some reason an ambulance is not available, transport the infant to the nearest medical facility while keeping them lying flat. (Если по какой-то причине скорая помощь недоступна, доставьте младенца в ближайшее медицинское учреждение, продолжая удерживать его в горизонтальном положении.)","media":[{"asset_id":"img-0e53218644d3ede0","url":"/media/img-0e53218644d3ede0.png","content_type":"image/png","association":"source-layout-adjacent-instruction","source_image_shape_id":"10","rights_status":"uncertain","review_required":true},{"asset_id":"img-ddfcc91e24d2abba","url":"/media/img-ddfcc91e24d2abba.png","content_type":"image/png","association":"source-layout-adjacent-instruction","source_image_shape_id":"11","rights_status":"uncertain","review_required":true}],"next":null,"input":null,"source":{"original_shape_id":"4232","canonical_node_id":"72678c6f-3d3f-5bb2-a600-ef5fb5f0449d"}},{"id":"c9315fb1-89bd-53d1-8fa1-036251502803","role":"choice","text":"Choose one or more of the following options: (Выберите один или несколько из нижеследующих вариантов:)","media":[{"asset_id":"img-b26158b441cc07ed","url":"/media/img-b26158b441cc07ed.png","content_type":"image/png","association":"source-layout-adjacent-instruction","source_image_shape_id":"1","rights_status":"uncertain","review_required":true}],"next":null,"input":{"kind":"choice","selection_mode":"multiple","presentation":"option_list","prompt":"Choose one or more of the following options: (Выберите один или несколько из нижеследующих вариантов:)","options":[{"id":"4234-option-1","label":"Abdominal pain (Боль в животе)","canonical_value":null,"exclusive":false,"result_codes":["C"],"go_to":"c202f415-71cf-5cab-a88a-843362c0bd89","source":{"label_shape_id":"4244","result_code_shape_ids":["4253"],"label_source":"group-row"},"review_required":true},{"id":"4234-option-2","label":"Breathing difficulties (Затрудненное дыхание)","canonical_value":null,"exclusive":false,"result_codes":["A"],"go_to":"72678c6f-3d3f-5bb2-a600-ef5fb5f0449d","source":{"label_shap