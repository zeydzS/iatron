{
  "name": "iatron-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:data": "node scripts/bundle-content.mjs",
    "rebuild:data": "node scripts/run-data-build.mjs && npm run build:data",
    "build:web": "vite build && node scripts/build-offline.mjs",
    "build": "npm run build:data && npm run build:web",
    "check": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run build:data && vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
